# Server-side configuration. Never commit real values or expose them to the browser.
# Copy to .env (local) or set them in the server environment.

# Public address of the site (used to build absolute URLs behind a proxy).
PUBLIC_ORIGIN=https://sirtraver.com
# Folder where data.json (waitlist, contact messages) is kept.
DATA_DIR=./data

# Gumroad API token used to read the product catalog (Resources page).
GUMROAD_ACCESS_TOKEN=
# Optional: Gumroad product ID to keep off the public catalog.
GUMROAD_HIDDEN_PRODUCT_ID=

# Bearer token for the private CSV exports:
#   GET /api/waitlist-admin            launch waitlist
#   GET /api/waitlist-admin?type=contact   contact messages
WAITLIST_ADMIN_TOKEN=

# Brevo (free plan): double opt-in newsletter and contact form emails. All optional.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# Address that receives contact form messages, and the verified sender in Brevo.
CONTACT_TO=
CONTACT_FROM=

# Cookieless analytics (Umami). Optional: both values switch it on.
ANALYTICS_SRC=
ANALYTICS_WEBSITE_ID=
