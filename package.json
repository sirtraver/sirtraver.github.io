{
  "name": "sirtraver",
  "private": true,
  "type": "module",
  "description": "sirtraver.com — portfolio of Javier Traver (Node server, no runtime dependencies)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "export": "node scripts/build.mjs && node scripts/export-static.mjs",
    "deploy": "npm test && node --env-file-if-exists=.env scripts/export-static.mjs && node scripts/deploy-gh-pages.mjs",
    "test": "node scripts/build.mjs && node --test \"tests/*.test.mjs\"",
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env server/node.mjs --offline --memory",
    "start": "node --env-file-if-exists=.env server/node.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
